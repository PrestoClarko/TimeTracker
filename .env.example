# Firebase web app config — copy this file to `.env` and fill in your values.
# Find these under: Firebase Console → Project settings → Your apps → SDK setup & config.
# These are PUBLIC client keys; access is controlled by Firestore security rules.
# Leave them blank to run the app in local-only mode (no sign-in, data stays in the browser).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
